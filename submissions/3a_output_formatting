"""Formatted IBM Watson NLP emotion detector for Question 4."""

import requests

SERVICE_URL = (
    "https://sn-watson-emotion.labs.skills.network/"
    "v1/watson.runtime.nlp.v1/NlpService/EmotionPredict"
)
MODEL_ID = "emotion_aggregated-workflow_lang_en_stock"
EMOTION_NAMES = ("anger", "disgust", "fear", "joy", "sadness")


def emotion_detector(text_to_analyse):
    """Return the five Watson emotion scores and the dominant emotion."""
    headers = {"grpc-metadata-mm-model-id": MODEL_ID}
    payload = {"raw_document": {"text": text_to_analyse}}
    try:
        response = requests.post(
            SERVICE_URL,
            headers=headers,
            json=payload,
            timeout=8,
        )
    except requests.RequestException:
        return None

    if response.status_code != 200:
        return None

    try:
        emotions = response.json()["emotionPredictions"][0]["emotion"]
        scores = {name: emotions[name] for name in EMOTION_NAMES}
    except (KeyError, IndexError, TypeError, ValueError):
        return None

    return {
        **scores,
        "dominant_emotion": max(scores, key=scores.__getitem__),
    }
