"""Pylint-clean Coursera Flask server with blank-input handling."""

from flask import Flask, render_template, request

from EmotionDetection.emotion_detection import emotion_detector

app = Flask(__name__)


@app.route("/")
def home():
    """Render the text entry page."""
    return render_template("index.html")


@app.route("/emotionDetector")
def emotion_detector_route():
    """Return the exact input error or a formatted analysis response."""
    text = request.args.get("textToAnalyze", "")
    if not text.strip():
        return "Invalid input! Try again."

    result = emotion_detector(text)
    if result is None:
        return "Emotion analysis unavailable. Please try again."

    return (
        "For the given statement, the system response is "
        f"'anger': {result['anger']}, 'disgust': {result['disgust']}, "
        f"'fear': {result['fear']}, 'joy': {result['joy']} and "
        f"'sadness': {result['sadness']}. The dominant emotion is "
        f"{result['dominant_emotion']}."
    )


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
